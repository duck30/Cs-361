{% extends "base_layout.html" %}
{% block title %}Pokedex Page{% endblock %}
{% block header %}Pokedex Page{% endblock %}
{% block content %}

<h1>
    Pokedex
</h1>
<h3>
    Browsing pokemon in pokedex
</h3>


<!-- Browsing data -->
<section id="data">
    <table border="1" cellpadding="5">
        {% if data %}
        <thead>
            <tr>
                <th>ADD</th>
                <!--Getting column headers for table-->
                {% for key in data[0].keys() %}
                <th>{{ key }}</th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
            {% for item in data %}
            <tr>
                <td><a href="add_pokemon/{{item.name}}" class="addbtn">Add</a></td>
                <!--Getting row data for table-->                
                {% for key in item.keys() %}
                <td>{{ item[key] }}</td>
                {% endfor %}
            </tr>
            {% endfor %}
        </tbody>
        {% endif %}
    </table>
</section>



{% endblock %}

